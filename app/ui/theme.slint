// Token desain: warna dasar mengikuti mode gelap/terang; gradien & ornamen mengikuti skema warna (accent, accent2).
export global Theme {
    in property <bool> dark: true;
    in property <color> accent: #cba6f7;
    in property <color> accent2: #89b4fa;

    out property <color> bg: dark ? #0a0b14 : #f5f6fb;
    out property <color> surface: dark ? #131528ee : #ffffff;
    out property <color> surface2: dark ? #1a1d36ee : #edf0f8;
    out property <color> surface3: dark ? #232746ee : #e2e6f4;
    out property <color> border: dark ? #ffffff1c : #00000014;
    out property <color> text: dark ? #f5f7fd : #11131a;
    out property <color> muted: dark ? #8f97b0 : #646b80;
    out property <color> good: #3dd68c;
    out property <color> warn: #ffab3d;
    out property <color> bad: #ff5c6c;
    out property <color> on-accent: #0b0d14;
    out property <color> screen: #171826;

    out property <color> glow: accent.with-alpha(dark ? 0.28 : 0.18);
    out property <color> glow2: accent2.with-alpha(dark ? 0.20 : 0.14);
    out property <color> edge: accent.with-alpha(dark ? 0.38 : 0.28);
    out property <brush> grad: @linear-gradient(90deg, accent 0%, accent2 100%);
    out property <brush> grad-v: @linear-gradient(160deg, accent 0%, accent2 100%);
    out property <brush> card-fill: @linear-gradient(155deg, surface 0%, surface2 100%);
    out property <brush> dock-fill: @linear-gradient(90deg, #101222f2 0%, #171a32f2 100%);

    out property <length> radius-card: 22px;
    out property <length> radius-island: 34px;
}
