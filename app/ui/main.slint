import { Theme } from "theme.slint";
import { AppState, FaceParams, SessionItem, ApprovalItem, EventItem, AlarmItem, LapItem, CommitRow, RepoRow, ClipItem, ShelfItem, DayCell, PrayerRow, SearchHit } from "state.slint";
import { Icon, Icons, Label, Muted, Btn, IconBtn, Badge, Ornaments, Sparkle, Wave } from "widgets.slint";
import { Mascot } from "mascot.slint";
import { HomePage, AiPage, MusicPage, ClockPage } from "pages_a.slint";
import { CalendarPage, GithubPage, SystemPage, ClipPage, SettingsPage } from "pages_b.slint";

export { AppState, Theme, FaceParams, SessionItem, ApprovalItem, EventItem, AlarmItem, LapItem, CommitRow, RepoRow, ClipItem, ShelfItem, DayCell, PrayerRow, SearchHit }

component NavItem inherits Rectangle {
    in property <string> d;
    in property <int> index;
    in property <int> badge: 0;
    horizontal-stretch: 1;
    max-width: 44px;
    height: 44px;
    border-radius: 16px;
    background: AppState.page == root.index ? @linear-gradient(145deg, Theme.accent.with-alpha(0.32) 0%, Theme.accent2.with-alpha(0.18) 100%) : (ta.has-hover ? Theme.surface2 : transparent);
    border-width: AppState.page == root.index ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.5);
    animate background { duration: 140ms; }
    Icon {
        d: root.d;
        size: 22px;
        tint: AppState.page == root.index ? #ffffff : Theme.muted;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if AppState.page == root.index : Rectangle {
        x: (parent.width - 5px) / 2;
        y: parent.height - 7px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: #ffffff;
        Rectangle {
            x: -2px; y: -2px; width: 9px; height: 9px; border-radius: 4.5px;
            background: Theme.accent.with-alpha(0.4);
        }
    }
    if root.badge > 0 : Rectangle {
        x: parent.width - 15px;
        y: 0px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.bad;
        Text { text: root.badge; color: #ffffff; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { AppState.page = root.index; AppState.page-changed(root.index); } }
}

// kepala halaman: maskot + orbit kosmik, sapaan, tombol bulat
component PageHeader inherits Rectangle {
    height: 72px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 84px;
            if AppState.mascot-on : Path {
                x: 0px; y: 32px; width: 84px; height: 36px; viewbox-width: 84; viewbox-height: 36;
                commands: "M 4 14 C 4 2 70 2 80 12 C 84 20 40 32 6 22";
                stroke: Theme.accent.with-alpha(0.8);
                stroke-width: 2.5px;
                fill: transparent;
            }
            if AppState.mascot-on : Mascot { face: AppState.face; size: 78px; x: 3px; y: 0px; clicked => { AppState.mascot-clicked(); } }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: AppState.greeting; color: Theme.text; font-size: 22px; font-weight: 800; overflow: elide; }
            Text { text: AppState.date-long; color: Theme.accent; font-size: 13px; font-weight: 600; overflow: elide; }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            IconBtn {
                d: AppState.page == 0 ? Icons.gear : Icons.close;
                size: 38px;
                clicked => { if (AppState.page == 0) { AppState.page = 8; AppState.page-changed(8); } else { AppState.collapse(); } }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Gravi Island";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                AppState.collapse();
                return accept;
            }
            return reject;
        }

        island := Rectangle {
            property <float> sc: Math.max(0.75, AppState.scale);
            x: AppState.isl-x;
            y: AppState.isl-y;
            width: AppState.isl-w;
            height: AppState.isl-h;
            border-radius: AppState.mode == 0 ? (AppState.vertical ? 36px * self.sc : self.height / 2) : 34px;
            background: AppState.mode == 0 ? (Theme.dark ? #050506 : #101114) : Theme.bg;
            border-width: 1px;
            border-color: AppState.mode == 0 ? Theme.accent.with-alpha(0.35) : Theme.edge;
            clip: true;
            animate x, y, width, height { duration: AppState.snap ? 0ms : 300ms; easing: ease-in-out; }
            animate border-radius, background { duration: AppState.snap ? 0ms : 300ms; }

            if AppState.mode != 0 : Ornaments { width: parent.width; height: parent.height; ghost: AppState.mode == 2; }

            // ================= PIL VERTIKAL =================
            if AppState.mode == 0 && AppState.vertical : Rectangle {
                width: parent.width;
                height: parent.height;
                TouchArea { clicked => { AppState.toggle-island(); } mouse-cursor: pointer; }
                VerticalLayout {
                    padding: 8px * island.sc;
                    spacing: 3px * island.sc;
                    alignment: center;
                    if AppState.mascot-on : Mascot {
                        face: AppState.face;
                        size: 58px * island.sc;
                        clicked => { AppState.toggle-island(); }
                    }
                    Text { text: AppState.clock; color: #f4f6fa; font-size: 15px * island.sc; font-weight: 800; horizontal-alignment: center; }
                    if AppState.ai-running > 0 : Text { text: "AI ×" + AppState.ai-running; color: Theme.accent; font-size: 10px * island.sc; font-weight: 800; horizontal-alignment: center; }
                    if AppState.ai-running == 0 && AppState.pill-line != "" : Text { text: AppState.pill-line; color: #8d95a5; font-size: 9px * island.sc; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                    HorizontalLayout { alignment: center; Icon { d: Icons.chev-down; size: 14px * island.sc; tint: #8d95a5; } }
                }
                if AppState.badge > 0 : Rectangle {
                    x: parent.width - 24px * island.sc;
                    y: 6px * island.sc;
                    width: 18px * island.sc;
                    height: 18px * island.sc;
                    border-radius: 9px * island.sc;
                    background: Theme.bad;
                    Text { text: AppState.badge; color: #ffffff; font-size: 10px * island.sc; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            // ================= PIL HORIZONTAL (dock atas) =================
            if AppState.mode == 0 && !AppState.vertical : Rectangle {
                width: parent.width;
                height: parent.height;
                TouchArea { clicked => { AppState.toggle-island(); } mouse-cursor: pointer; }
                HorizontalLayout {
                    padding-left: 8px * island.sc;
                    padding-right: 14px * island.sc;
                    spacing: 10px * island.sc;
                    alignment: center;
                    if AppState.mascot-on : Rectangle {
                        width: 50px * island.sc;
                        height: 38px * island.sc;
                        y: (parent.height - self.height) / 2;
                        Path {
                            x: -1px * island.sc; y: 15px * island.sc; width: 52px * island.sc; height: 20px * island.sc; viewbox-width: 52; viewbox-height: 20;
                            commands: "M 2 8 C 2 1 44 1 50 7 C 53 12 26 19 4 14";
                            stroke: Theme.accent.with-alpha(0.85);
                            stroke-width: 1.8px;
                            fill: transparent;
                        }
                        Mascot {
                            face: AppState.face;
                            size: 46px * island.sc;
                            x: 2px * island.sc;
                            y: (parent.height - self.height) / 2;
                            clicked => { AppState.toggle-island(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px * island.sc;
                            height: 8px * island.sc;
                            border-radius: 4px * island.sc;
                            background: Theme.good;
                        }
                    }
                    Text { text: AppState.clock; color: #f4f6fa; font-size: 18px * island.sc; font-weight: 800; vertical-alignment: center; }
                    Text { text: AppState.ai-running > 0 ? "AI ×" + AppState.ai-running : AppState.pill-line; color: #9aa1b4; font-size: 13px * island.sc; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if AppState.ai-running > 1 : Rectangle {
                        width: 58px * island.sc;
                        clip: true;
                        HorizontalLayout {
                            spacing: 0px;
                            for s in AppState.sessions : Rectangle {
                                width: s.running ? 28px * island.sc : 0px;
                                Rectangle {
                                    x: 0px; y: (parent.height - 24px * island.sc) / 2; width: 24px * island.sc; height: 24px * island.sc; border-radius: 12px * island.sc;
                                    background: s.tint.with-alpha(0.35);
                                    border-width: 1px; border-color: s.tint;
                                    Text { text: s.mark; color: #ffffff; font-size: 9px * island.sc; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if AppState.badge > 0 : VerticalLayout { alignment: center; Badge { text: AppState.badge + "!"; tint: Theme.bad; } }
                    VerticalLayout { alignment: center; Icon { d: Icons.chev-down; size: 16px * island.sc; tint: #8d95a5; } }
                }
            }

            // ================= PERINGATAN: PERSETUJUAN =================
            if AppState.mode == 1 : Rectangle {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        height: 58px;
                        Rectangle {
                            width: 68px;
                            if AppState.mascot-on : Path {
                                x: 0px; y: 26px; width: 68px; height: 28px; viewbox-width: 68; viewbox-height: 28;
                                commands: "M 3 11 C 3 1 56 1 64 10 C 67 16 32 26 5 18";
                                stroke: Theme.accent.with-alpha(0.8);
                                stroke-width: 2px;
                                fill: transparent;
                            }
                            if AppState.mascot-on : Mascot { face: AppState.face; size: 64px; interactive: false; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "Butuh persetujuan"; color: Theme.text; font-size: 20px; font-weight: 800; }
                            Text { text: AppState.approvals.length > 1 ? AppState.approvals.length + " permintaan menunggu" : "1 permintaan menunggu"; color: Theme.accent; font-size: 13px; font-weight: 600; }
                        }
                        VerticalLayout { alignment: center; IconBtn { d: Icons.close; size: 36px; clicked => { AppState.collapse(); } } }
                    }
                    if AppState.approvals.length > 0 : Rectangle {
                        vertical-stretch: 1;
                        border-radius: 22px;
                        background: @linear-gradient(155deg, Theme.surface 0%, Theme.surface2 100%);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.4);
                        Rectangle { border-radius: 22px; background: @linear-gradient(160deg, Theme.accent.with-alpha(0.12) 0%, transparent 60%); }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 42px; height: 42px; border-radius: 21px;
                                        background: AppState.approvals[0].tint.with-alpha(0.28);
                                        Text { text: AppState.approvals[0].mark; color: AppState.approvals[0].tint; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: AppState.approvals[0].tool; color: Theme.text; font-size: 16px; font-weight: 800; overflow: elide; }
                                    Text { text: AppState.approvals[0].summary; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.edge; }
                            Muted { text: "Akses ke:"; }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout { alignment: center; Icon { d: Icons.folder; size: 18px; tint: Theme.muted; } }
                                Text { text: AppState.approvals[0].cwd; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { text: "Setujui"; kind: 1; clicked => { AppState.approve(AppState.approvals[0].id, 1); } }
                                Btn { text: "Tolak"; kind: 2; clicked => { AppState.approve(AppState.approvals[0].id, 0); } }
                                Rectangle { horizontal-stretch: 1; }
                                Btn { text: AppState.approvals.length > 1 ? "Semua" : "Terminal"; icon: Icons.terminal; clicked => { if (AppState.approvals.length > 1) { AppState.page = 1; AppState.toggle-island(); } else { AppState.approve(AppState.approvals[0].id, 2); } } }
                            }
                        }
                    }
                }
            }

            // ================= PANEL PENUH =================
            if AppState.mode == 2 : Rectangle {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 14px;
                    padding-bottom: 18px;
                    spacing: 10px;
                    PageHeader { }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        if AppState.page == 0 : HomePage { }
                        if AppState.page == 1 : AiPage { }
                        if AppState.page == 2 : MusicPage { }
                        if AppState.page == 3 : ClockPage { }
                        if AppState.page == 4 : CalendarPage { }
                        if AppState.page == 5 : GithubPage { }
                        if AppState.page == 6 : SystemPage { }
                        if AppState.page == 7 : ClipPage { }
                        if AppState.page == 8 : SettingsPage { }
                    }
                    Rectangle {
                        height: 62px;
                        border-radius: 31px;
                        background: Theme.dock-fill;
                        border-width: 1px;
                        border-color: #ffffff18;
                        HorizontalLayout {
                            padding: 8px;
                            alignment: space-around;
                            NavItem { d: Icons.home; index: 0; }
                            NavItem { d: Icons.ai; index: 1; badge: AppState.badge; }
                            NavItem { d: Icons.music; index: 2; }
                            NavItem { d: Icons.clock; index: 3; }
                            NavItem { d: Icons.calendar; index: 4; }
                            NavItem { d: Icons.github; index: 5; }
                            NavItem { d: Icons.system; index: 6; }
                            NavItem { d: Icons.tray; index: 7; }
                            NavItem { d: Icons.settings; index: 8; }
                        }
                    }
                }
                if AppState.toast != "" : Rectangle {
                    y: parent.height - 138px;
                    x: (parent.width - self.width) / 2;
                    width: Math.min(parent.width - 32px, toast-text.preferred-width + 88px);
                    height: 56px;
                    border-radius: 20px;
                    background: @linear-gradient(90deg, #13152bee 0%, #171932ee 100%);
                    border-width: 1px;
                    border-color: AppState.toast-kind == 2 ? Theme.bad.with-alpha(0.6) : AppState.toast-kind == 1 ? Theme.accent.with-alpha(0.6) : Theme.good.with-alpha(0.6);
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: (AppState.toast-kind == 2 ? Theme.bad : AppState.toast-kind == 1 ? Theme.accent : Theme.good).with-alpha(0.24);
                                Icon {
                                    d: AppState.toast-kind == 2 ? Icons.warn : AppState.toast-kind == 1 ? Icons.info : Icons.ok;
                                    size: 18px;
                                    tint: AppState.toast-kind == 2 ? Theme.bad : AppState.toast-kind == 1 ? Theme.accent : Theme.good;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: AppState.toast-kind == 2 ? "Terjadi Kesalahan" : AppState.toast-kind == 1 ? "Informasi" : "Berhasil!";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 800;
                            }
                            toast-text := Text { text: AppState.toast; color: Theme.muted; font-size: 11px; font-weight: 600; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                d: Icons.close;
                                size: 28px;
                                filled: false;
                                tint: Theme.muted;
                                clicked => { AppState.toast = ""; }
                            }
                        }
                    }
                }
            }
        }
    }
}
