import { ScrollView } from "std-widgets.slint";
// Antigravity Island (Slint). Satu jendela transparan tetap di tepi kanan; yang beranimasi hanya ukuran "island" di dalamnya.

export struct MoodView {
    eye-h: float,
    eye-w: float,
    eye-dy: float,
    eye-dx: float,
    eye-shape: int,
    mouth: int,
    glyph: string,
    glyph-type: int,
    peek: bool,
    eye-color: color,
}

export struct SessionItem {
    title: string,
    sub: string,
    meta: string,
    mark: string,
    tint: color,
    running: bool,
    action: bool,
}

export global Theme {
    in-out property <bool> light: false;
    in-out property <color> cyan: #5ae0ff;
    out property <color> bg: light ? #f2f2f6 : #000000;
    out property <color> surface: light ? #ffffff : #141416;
    out property <color> border: light ? #0000000f : #ffffff12;
    out property <color> chip: light ? #0000000a : #ffffff12;
    out property <color> fg: light ? #16161a : #f5f5f7;
    out property <color> mut: light ? #16161a99 : #ffffff99;
    out property <color> mut2: light ? #16161a66 : #ffffff61;
    out property <color> card: light ? #ffffff : #141416;
    out property <color> line: light ? #0000001a : #ffffff24;
    out property <color> amber: #ffb54d;
    out property <color> good: #34d399;
}

// Maskot resmi Gravi Bot (vektor mecha) dengan telinga pelangi & 12 ekspresi halus.
component Gravi inherits Rectangle {
    in property <length> size: 40px;
    in property <bool> blink: false;
    in property <MoodView> mood: {
        eye-h: 1.0, eye-w: 1.0, eye-dy: 0.0, eye-dx: 0.0,
        eye-shape: 0, mouth: 0, glyph: "", glyph-type: 0, peek: false,
        eye-color: #5ae0ff
    };
    width: self.size;
    height: self.size * 0.88;

    property <length> u: self.size / 100;
    property <length> eh: root.blink ? 2.5 * root.u : max(2.5 * root.u, root.mood.eye-h * 18.0 * root.u);
    property <length> ew: max(4.0 * root.u, root.mood.eye-w * 9.0 * root.u);
    property <length> m-y: 24 * root.u + root.mood.eye-dy * 5 * root.u - root.eh / 2;
    property <length> lx: 18 * root.u + root.mood.eye-dx * 6 * root.u;
    property <length> rx: 45 * root.u + root.mood.eye-dx * 6 * root.u;

    // Telinga Kiri Luar (Mecha Hitam)
    Path {
        x: 4 * root.u; y: 0; width: 34 * root.u; height: 36 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 34; viewbox-height: 36;
        commands: "M 4 36 L 14 3 Q 18 0 22 5 L 34 36 Z";
        fill: #14151c;
    }
    // Telinga Kiri Dalam (Gradien Pelangi Dingin: Biru -> Cyan -> Hijau)
    Path {
        x: 8 * root.u; y: 5 * root.u; width: 24 * root.u; height: 28 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 28;
        commands: "M 3 28 L 10 5 Q 13 2 16 6 L 23 28 Z";
        fill: @linear-gradient(145deg, #1d4ed8 0%, #06b6d4 50%, #10b981 100%);
    }

    // Telinga Kanan Luar (Mecha Hitam)
    Path {
        x: 62 * root.u; y: 0; width: 34 * root.u; height: 36 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 34; viewbox-height: 36;
        commands: "M 0 36 L 12 5 Q 16 0 20 3 L 30 36 Z";
        fill: #14151c;
    }
    // Telinga Kanan Dalam (Gradien Pelangi Hangat: Merah -> Oranye -> Kuning)
    Path {
        x: 68 * root.u; y: 5 * root.u; width: 24 * root.u; height: 28 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 28;
        commands: "M 1 28 L 8 6 Q 11 2 14 5 L 21 28 Z";
        fill: @linear-gradient(215deg, #dc2626 0%, #ea580c 50%, #facc15 100%);
    }

    // Bodi Helm Utama (Putih Squircle 3D dengan Shading Lavender Halus)
    Rectangle {
        x: 5 * root.u;
        y: root.mood.peek ? 24 * root.u : 14 * root.u;
        width: 90 * root.u;
        height: 68 * root.u;
        border-radius: 34 * root.u;
        background: @linear-gradient(180deg, #ffffff 0%, #f2f4fb 70%, #d8dcee 100%);
        border-width: 1.4px;
        border-color: #d1d5e5;
        clip: true;

        // Bayangan lembut bawah helm
        Rectangle {
            x: 0; y: 56 * root.u; width: 100%; height: 12 * root.u;
            background: @linear-gradient(180deg, #00000000 0%, #bcc2d655 100%);
        }

        // Visor Kaca Hitam
        Rectangle {
            x: 9 * root.u; y: 10 * root.u; width: 72 * root.u; height: 48 * root.u;
            border-radius: 24 * root.u;
            background: @linear-gradient(180deg, #151824 0%, #090b10 100%);
            border-width: 1.2px;
            border-color: #272c3d;
            clip: true;

            // Specular Gloss Kiri Atas Visor
            Rectangle {
                x: 6 * root.u; y: 5 * root.u; width: 22 * root.u; height: 10 * root.u;
                border-radius: 5 * root.u;
                background: @linear-gradient(135deg, rgba(255, 255, 255, 0.38) 0%, rgba(255, 255, 255, 0.04) 100%);
            }

            // === SEPASANG MATA VISOR DENGAN 12 EKSPRESI ===
            // 0. Bentuk Kapsul Tegak (Idle, Working, Searching, Peek)
            if root.mood.eye-shape == 0: Rectangle {
                x: root.lx; y: root.m-y; width: root.ew; height: root.eh;
                border-radius: root.ew / 2; background: root.mood.eye-color;
                animate height { duration: 100ms; }
            }
            if root.mood.eye-shape == 0: Rectangle {
                x: root.rx; y: root.m-y; width: root.ew; height: root.eh;
                border-radius: root.ew / 2; background: root.mood.eye-color;
                animate height { duration: 100ms; }
            }

            // 1. Bentuk Senyum ^^ (Happy, Success, Love, Music)
            if root.mood.eye-shape == 1: Path {
                x: root.lx - 2 * root.u; y: root.m-y; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 11 Q 7 1 13 11";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }
            if root.mood.eye-shape == 1: Path {
                x: root.rx - 2 * root.u; y: root.m-y; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 11 Q 7 1 13 11";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }

            // 2. Bentuk Bulat Besar OO (Surprised / Alert)
            if root.mood.eye-shape == 2: Rectangle {
                x: root.lx - 2 * root.u; y: root.m-y - 1 * root.u;
                width: 14 * root.u; height: 14 * root.u; border-radius: 7 * root.u;
                background: root.mood.eye-color;
            }
            if root.mood.eye-shape == 2: Rectangle {
                x: root.rx - 2 * root.u; y: root.m-y - 1 * root.u;
                width: 14 * root.u; height: 14 * root.u; border-radius: 7 * root.u;
                background: root.mood.eye-color;
            }

            // 3. Bentuk Tidur/Tenang -- (Sleepy, Sleeping, Prayer)
            if root.mood.eye-shape == 3: Rectangle {
                x: root.lx - 1 * root.u; y: 24 * root.u;
                width: 12 * root.u; height: 3.2 * root.u; border-radius: 1.6 * root.u;
                background: root.mood.eye-color;
            }
            if root.mood.eye-shape == 3: Rectangle {
                x: root.rx - 1 * root.u; y: 24 * root.u;
                width: 12 * root.u; height: 3.2 * root.u; border-radius: 1.6 * root.u;
                background: root.mood.eye-color;
            }

            // 4. Bentuk Bingung / Confused (Asimetris: kiri kapsul, kanan strip)
            if root.mood.eye-shape == 4: Rectangle {
                x: root.lx; y: root.m-y; width: root.ew; height: root.eh;
                border-radius: root.ew / 2; background: root.mood.eye-color;
            }
            if root.mood.eye-shape == 4: Rectangle {
                x: root.rx; y: 24 * root.u; width: 12 * root.u; height: 3.2 * root.u;
                border-radius: 1.6 * root.u; background: root.mood.eye-color;
            }

            // 5. Bentuk Sayu/Sedih (Sad)
            if root.mood.eye-shape == 5: Path {
                x: root.lx - 1 * root.u; y: root.m-y + 2 * root.u; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 2 Q 7 11 13 2";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }
            if root.mood.eye-shape == 5: Path {
                x: root.rx - 1 * root.u; y: root.m-y + 2 * root.u; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 2 Q 7 11 13 2";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }

            // 6. Bentuk Menyipit Miring (Thinking / Focused)
            if root.mood.eye-shape == 6: Path {
                x: root.lx; y: root.m-y; width: 12 * root.u; height: 10 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 10;
                commands: "M 1 2 L 11 9";
                stroke: root.mood.eye-color; stroke-width: 3.5px; fill: transparent;
            }
            if root.mood.eye-shape == 6: Path {
                x: root.rx; y: root.m-y; width: 12 * root.u; height: 10 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 10;
                commands: "M 1 9 L 11 2";
                stroke: root.mood.eye-color; stroke-width: 3.5px; fill: transparent;
            }

            // 7. Bentuk Miring Linglung (Error)
            if root.mood.eye-shape == 7: Path {
                x: root.lx; y: root.m-y; width: 12 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 12;
                commands: "M 2 10 L 10 2";
                stroke: root.mood.eye-color; stroke-width: 3.5px; fill: transparent;
            }
            if root.mood.eye-shape == 7: Path {
                x: root.rx; y: root.m-y; width: 12 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 12;
                commands: "M 2 2 L 10 10";
                stroke: root.mood.eye-color; stroke-width: 3.5px; fill: transparent;
            }
        }
    }

    // Aksesoris / Glyph Melayang (Tanda Seru, Tanya, Zzz, Bintang, dll)
    if root.mood.glyph != "": Text {
        x: root.size * 0.76;
        y: -root.size * 0.16;
        text: root.mood.glyph;
        color: root.mood.eye-color;
        font-size: root.size * 0.36;
        font-weight: 800;
    }
}

// Lencana penyedia AI; berdenyut halus saat sesi berjalan.
component Mark inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <bool> running;
    in property <bool> action;
    in property <bool> breathe;
    in property <length> sz: 32px;
    width: self.sz;
    height: self.sz;
    border-radius: self.sz * 0.32;
    background: root.action ? Theme.amber.with-alpha(0.25) : (root.running ? root.tint.with-alpha(0.22) : #ffffff14);

    Rectangle {
        visible: root.running || root.action;
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        background: root.action ? Theme.amber : root.tint;
        opacity: root.breathe ? 0.0 : 0.32;
        animate opacity {
            duration: 900ms;
            easing: ease-in-out;
        }
    }
    Text {
        text: root.action ? "!" : root.text;
        color: root.action ? Theme.amber : (root.running ? root.tint : Theme.mut);
        font-size: root.sz * 0.34;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Tile inherits Rectangle {
    background: Theme.surface;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.border;
}

component Cap inherits Text {
    color: Theme.mut2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

component TabBtn inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 28px;
    Text {
        text: root.text;
        color: root.on ? Theme.fg : Theme.mut2;
        font-size: 11px;
        font-weight: root.on ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: root.height - 3px;
        x: (root.width - self.width) / 2;
        width: root.on ? 14px : 0px;
        height: 2px;
        border-radius: 1px;
        background: Theme.cyan;
        animate width { duration: 220ms; easing: ease-out; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> primary;
    in property <color> tint: Theme.cyan;
    callback clicked();
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background: root.primary ? root.tint : Theme.chip;
    opacity: ta.pressed ? 0.7 : 1.0;
    animate opacity { duration: 90ms; }
    Text { text: root.glyph; color: root.primary ? #000000 : Theme.fg; font-size: 17px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.fg;
    in property <bool> filled;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: root.filled ? root.tint : Theme.chip;
    opacity: pa.pressed ? 0.7 : 1.0;
    Text { text: root.text; color: root.filled ? #000000 : root.tint; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    pa := TouchArea { clicked => { root.clicked(); } }
}

component ToggleRow inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled();
    height: 40px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text { text: root.text; color: Theme.fg; font-size: 12.5px; vertical-alignment: center; }
        Rectangle {
            width: 40px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: root.on ? Theme.cyan : Theme.line;
                animate background { duration: 160ms; }
                Rectangle {
                    x: root.on ? 20px : 2px;
                    y: 2px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: #ffffff;
                    animate x { duration: 180ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
                }
            }
        }
    }
    TouchArea { clicked => { root.toggled(); } }
}

component Ring inherits Rectangle {
    in property <float> p;
    in property <color> tint;
    in property <string> value;
    width: 58px;
    height: 58px;
    property <float> q: max(0.004, min(0.996, root.p));
    property <angle> th: root.q * 360deg;
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 40; viewbox-height: 40;
        commands: "M 20 4 A 16 16 0 1 1 20 36 A 16 16 0 1 1 20 4";
        stroke: Theme.line; stroke-width: 3.2px; fill: transparent;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 40; viewbox-height: 40;
        commands: "M 20 4 A 16 16 0 " + (root.q > 0.5 ? "1" : "0") + " 1 " + (20 + 16 * sin(root.th)) + " " + (20 - 16 * cos(root.th));
        stroke: root.tint; stroke-width: 3.2px; stroke-line-cap: round; fill: transparent;
    }
    Text { text: root.value; color: Theme.fg; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

component SessionRow inherits Tile {
    in property <SessionItem> item;
    in property <bool> breathe;
    height: 58px;
    border-radius: 16px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Rectangle {
            width: 34px;
            Mark {
                y: (parent.height - self.height) / 2;
                sz: 34px;
                text: root.item.mark;
                tint: root.item.tint;
                running: root.item.running;
                action: root.item.action;
                breathe: root.breathe;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.item.title; color: Theme.fg; font-size: 12.5px; font-weight: 600; overflow: elide; }
            Text { text: root.item.sub; color: Theme.mut; font-size: 11px; overflow: elide; }
        }
        Rectangle {
            width: 62px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 22px;
                border-radius: 11px;
                background: root.item.action ? Theme.amber.with-alpha(0.2) : (root.item.running ? root.item.tint.with-alpha(0.2) : Theme.chip);
                Text {
                    text: root.item.meta;
                    color: root.item.action ? Theme.amber : (root.item.running ? root.item.tint : Theme.mut2);
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export struct LaunchItem { name: string, hint: string }

export component MainWindow inherits Window {
    title: "Antigravity Island";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 440px;
    preferred-height: 680px;

    in-out property <int> mode: 0; // 0 idle, 1 live, 2 terbuka
    in-out property <int> tab: 0;  // 0 home, 1 sesi, 2 musik, 3 fokus, 4 klip, 5 cari, 6 shelf, 7 atur
    in property <[SessionItem]> sessions;
    in property <[SessionItem]> live;
    in property <int> running-count;
    in property <MoodView> mood: { eye-h: 1.0, eye-dy: 0.0, mouth: 0, glyph: "", eye-color: #5ae0ff };
    in property <bool> media-active;
    in property <bool> media-playing;
    in property <string> media-title: "Memuat…";
    in property <string> media-artist;
    in property <[string]> shelf;
    callback media-cmd(string);
    callback shelf-add();
    callback shelf-open(int);
    callback shelf-remove(int);
    in property <string> clock;
    in property <string> date;
    in property <string> greeting;
    in property <string> prayer-name;
    in property <string> prayer-time;
    in property <string> prayer-left;
    in property <string> cpu-text;
    in property <string> mem-text;
    in property <float> cpu;
    in property <float> mem;
    in property <bool> breathe;
    in property <bool> blink;
    in property <string> weather-text: "—";
    in property <string> event-text: "Tidak ada agenda";
    in property <string> focus-label: "25:00";
    in property <string> focus-phase: "Siap";
    in property <bool> focus-running;
    in property <int> focus-done;
    in property <[string]> clips;
    in property <[LaunchItem]> results;
    in-out property <bool> hover-open;
    in-out property <bool> src-claude: true;
    in-out property <bool> src-copilot: true;
    in-out property <bool> src-agy: true;
    in-out property <bool> src-desk: true;
    in-out property <bool> adzan: true;
    in property <string> city: "Bandung";
    callback clicked-open();
    callback clicked-close();
    callback focus-start();
    callback focus-pause();
    callback focus-stop();
    callback copy-clip(int);
    callback query-changed(string);
    callback run-result(int);
    callback settings-changed();
    callback cycle-city();
    callback quit();

    out property <length> hit-x: island.x;
    out property <length> hit-y: island.y - 16px;
    out property <length> hit-w: island.width;
    out property <length> hit-h: island.height + 32px;

    property <length> open-h: root.height - 40px;
    property <length> tw: root.mode == 0 ? 46px : (root.mode == 1 ? 50px : 392px);
    property <length> th: root.mode == 0 ? 60px : (root.mode == 1 ? 62px + 52px * root.live.length + 18px : root.open-h);
    property <[string]> tabs: ["Home", "Sesi", "Musik", "Fokus", "Klip", "Cari", "Shelf", "Atur"];

    island := Rectangle {
        x: root.width - self.width;
        y: 20px;
        width: root.tw;
        height: root.th;
        background: Theme.bg;
        clip: true;
        border-top-left-radius: 28px;
        border-bottom-left-radius: 28px;
        animate width { duration: 420ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
        animate height { duration: 420ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }

        if root.mode < 2: TouchArea { clicked => { root.clicked-open(); } }
        if root.mode == 0: Gravi { x: island.width - self.width - 3px; y: 9px; size: 38px; blink: root.blink; mood: root.mood; }
        if root.mode == 1: VerticalLayout {
            x: island.width - 50px;
            width: 50px;
            padding-top: 10px;
            spacing: 4px;
            alignment: start;
            Gravi { x: 6px; size: 36px; blink: root.blink; mood: root.mood; }
            for s in root.live: Rectangle {
                height: 48px;
                Mark { x: 9px; y: 2px; sz: 32px; text: s.mark; tint: s.tint; running: s.running; action: s.action; breathe: root.breathe; }
                Text { y: 36px; width: parent.width; text: s.meta; color: s.tint; font-size: 9.5px; font-weight: 700; horizontal-alignment: center; }
            }
        }

        if root.mode == 2: Rectangle {
            x: island.width - 392px;
            width: 392px;
            height: root.open-h;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 10px;

                // header
                HorizontalLayout {
                    spacing: 10px;
                    Gravi { size: 38px; blink: root.blink; mood: root.mood; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: root.greeting; color: Theme.fg; font-size: 15px; font-weight: 700; }
                        Text { text: root.running-count > 0 ? root.running-count + " sesi AI berjalan" : "Semua tenang"; color: Theme.mut; font-size: 11px; }
                    }
                    Rectangle {
                        width: 30px; height: 30px; border-radius: 15px;
                        background: closer.has-hover ? Theme.line : Theme.chip;
                        animate background { duration: 120ms; }
                        Text { text: "✕"; color: Theme.mut; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        closer := TouchArea { clicked => { root.clicked-close(); } }
                    }
                }

                // tab
                Rectangle {
                    height: 30px;
                    border-radius: 15px;
                    background: Theme.chip;
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px;
                        for t[i] in root.tabs: TabBtn { text: t; on: root.tab == i; clicked => { root.tab = i; } }
                    }
                }

                // ---------- Home ----------
                if root.tab == 0: ScrollView {
                    VerticalLayout {
                        spacing: 8px;
                        Tile {
                            height: 104px;
                            HorizontalLayout {
                                padding: 16px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.clock; color: Theme.fg; font-size: 44px; font-weight: 600; }
                                    Text { text: root.date; color: Theme.mut; font-size: 12px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.weather-text; color: Theme.fg; font-size: 14px; font-weight: 600; horizontal-alignment: right; }
                                    Text { text: root.city; color: Theme.mut2; font-size: 10.5px; horizontal-alignment: right; }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Tile {
                                height: 100px;
                                VerticalLayout {
                                    padding: 14px; spacing: 2px; alignment: center;
                                    Cap { text: "SHOLAT · " + root.prayer-name; }
                                    Text { text: root.prayer-time; color: Theme.fg; font-size: 28px; font-weight: 700; }
                                    Text { text: root.prayer-left; color: Theme.good; font-size: 10.5px; font-weight: 600; overflow: elide; }
                                }
                            }
                            Tile {
                                height: 100px;
                                VerticalLayout {
                                    padding: 14px; spacing: 4px; alignment: center;
                                    Cap { text: "AGENDA"; }
                                    Text { text: root.event-text; color: Theme.fg; font-size: 12.5px; font-weight: 600; wrap: word-wrap; overflow: elide; }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Tile {
                                height: 86px;
                                HorizontalLayout {
                                    padding: 14px; spacing: 12px;
                                    Rectangle { width: 58px; Ring { y: (parent.height - self.height) / 2; p: root.cpu; tint: Theme.cyan; value: root.cpu-text; } }
                                    VerticalLayout { alignment: center; spacing: 2px; Cap { text: "CPU"; } Text { text: "prosesor"; color: Theme.mut; font-size: 11px; } }
                                }
                            }
                            Tile {
                                height: 86px;
                                HorizontalLayout {
                                    padding: 14px; spacing: 12px;
                                    Rectangle { width: 58px; Ring { y: (parent.height - self.height) / 2; p: root.mem; tint: #9b8cff; value: Math.round(root.mem * 100) + "%"; } }
                                    VerticalLayout { alignment: center; spacing: 2px; Cap { text: "RAM"; } Text { text: root.mem-text; color: Theme.mut; font-size: 11px; overflow: elide; } }
                                }
                            }
                        }
                        Tile {
                            height: 66px;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 14px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    Cap { text: "SESI AI"; }
                                    Text { text: root.running-count > 0 ? root.running-count + " berjalan" : "Tidak ada yang berjalan"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                                }
                                HorizontalLayout {
                                    alignment: end; spacing: 6px;
                                    for s in root.live: Rectangle {
                                        width: 34px;
                                        Mark { y: (parent.height - self.height) / 2; sz: 34px; text: s.mark; tint: s.tint; running: s.running; action: s.action; breathe: root.breathe; }
                                    }
                                }
                            }
                            TouchArea { clicked => { root.tab = 1; } }
                        }
                    }
                }

                // ---------- Sesi ----------
                if root.tab == 1: ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        if root.sessions.length == 0: Text { text: "Belum ada sesi terdeteksi."; color: Theme.mut2; font-size: 12px; }
                        for s in root.sessions: SessionRow { item: s; breathe: root.breathe; }
                    }
                }

                // ---------- Musik ----------
                if root.tab == 2: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Tile {
                        height: 96px;
                        HorizontalLayout {
                            padding: 16px; spacing: 14px;
                            Rectangle {
                                width: 64px; height: 64px; border-radius: 14px;
                                background: @linear-gradient(135deg, Theme.cyan 0%, #9b8cff 100%);
                                Text { text: "♪"; color: #00000099; font-size: 30px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 3px;
                                Text { text: root.media-active ? root.media-title : "Tidak ada media aktif"; color: Theme.fg; font-size: 14px; font-weight: 700; overflow: elide; }
                                Text { text: root.media-artist; color: Theme.mut; font-size: 12px; overflow: elide; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 14px;
                        IconBtn { glyph: "⏮"; clicked => { root.media-cmd("prev"); } }
                        IconBtn { glyph: root.media-playing ? "⏸" : "▶"; primary: true; width: 56px; height: 56px; border-radius: 28px; clicked => { root.media-cmd("play_pause"); } }
                        IconBtn { glyph: "⏭"; clicked => { root.media-cmd("next"); } }
                    }
                }

                // ---------- Fokus ----------
                if root.tab == 3: VerticalLayout {
                    spacing: 14px;
                    alignment: start;
                    Tile {
                        height: 150px;
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Text { text: root.focus-label; color: Theme.fg; font-size: 60px; font-weight: 600; horizontal-alignment: center; }
                            Text { text: root.focus-phase + "  ·  " + root.focus-done + " sesi selesai"; color: Theme.mut; font-size: 12px; horizontal-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 14px;
                        IconBtn { glyph: "↺"; clicked => { root.focus-stop(); } }
                        IconBtn { glyph: root.focus-running ? "⏸" : "▶"; primary: true; tint: Theme.amber; width: 56px; height: 56px; border-radius: 28px; clicked => { if root.focus-running { root.focus-pause(); } else { root.focus-start(); } } }
                    }
                }

                // ---------- Klip ----------
                if root.tab == 4: ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        if root.clips.length == 0: Text { text: "Salin teks apa pun; riwayatnya muncul di sini."; color: Theme.mut2; font-size: 12px; wrap: word-wrap; }
                        for c[i] in root.clips: Tile {
                            height: 40px; border-radius: 14px;
                            background: ct.has-hover ? Theme.chip : Theme.surface;
                            Text { x: 14px; width: parent.width - 28px; text: c; color: Theme.fg; font-size: 12px; overflow: elide; vertical-alignment: center; }
                            ct := TouchArea { clicked => { root.copy-clip(i); } }
                        }
                    }
                }

                // ---------- Cari ----------
                if root.tab == 5: VerticalLayout {
                    spacing: 8px;
                    Tile {
                        height: 44px; border-radius: 22px;
                        Text { x: 16px; text: "⌕"; color: Theme.mut2; font-size: 16px; vertical-alignment: center; height: 100%; }
                        q := TextInput {
                            x: 40px; width: parent.width - 86px; height: 100%;
                            font-size: 13px; color: Theme.fg; vertical-alignment: center; single-line: true;
                            edited => { root.query-changed(self.text); }
                            accepted => { root.run-result(0); }
                        }
                        if q.text == "": Text { x: 40px; text: "Aplikasi, 2+2, atau alamat web…"; color: Theme.mut2; font-size: 13px; vertical-alignment: center; height: 100%; }
                        Rectangle {
                            x: parent.width - 38px; y: 7px; width: 30px; height: 30px; border-radius: 15px; background: Theme.chip;
                            Text { text: "→"; color: Theme.fg; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.run-result(0); } }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            spacing: 4px;
                            for r[i] in root.results: Tile {
                                height: 42px; border-radius: 14px;
                                background: rt.has-hover ? Theme.chip : Theme.surface;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 8px;
                                    Text { text: r.name; color: Theme.fg; font-size: 12.5px; overflow: elide; vertical-alignment: center; }
                                    Text { text: r.hint; color: Theme.mut2; font-size: 10.5px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                rt := TouchArea { clicked => { root.run-result(i); } }
                            }
                        }
                    }
                }

                // ---------- Shelf ----------
                if root.tab == 6: VerticalLayout {
                    spacing: 8px;
                    Pill { text: "+  Tambah dari clipboard"; filled: true; tint: Theme.cyan; clicked => { root.shelf-add(); } }
                    Text { text: "Salin berkas di Explorer (Ctrl+C), lalu tekan tombol di atas."; color: Theme.mut2; font-size: 10.5px; wrap: word-wrap; }
                    ScrollView {
                        VerticalLayout {
                            spacing: 6px;
                            for f[i] in root.shelf: Tile {
                                height: 40px; border-radius: 14px;
                                background: sf.has-hover ? Theme.chip : Theme.surface;
                                Text { x: 14px; width: parent.width - 52px; text: f; color: Theme.fg; font-size: 12px; overflow: elide; vertical-alignment: center; }
                                sf := TouchArea { width: parent.width - 38px; clicked => { root.shelf-open(i); } }
                                Text { x: parent.width - 30px; width: 24px; text: "✕"; color: Theme.mut; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { x: parent.width - 38px; width: 38px; clicked => { root.shelf-remove(i); } }
                            }
                        }
                    }
                }

                // ---------- Atur ----------
                if root.tab == 7: ScrollView {
                    VerticalLayout {
                        spacing: 8px;
                        Tile {
                            VerticalLayout {
                                padding-top: 4px; padding-bottom: 4px;
                                ToggleRow { text: "Mode terang"; on: Theme.light; toggled => { Theme.light = !Theme.light; root.settings-changed(); } }
                                ToggleRow { text: "Buka saat kursor di atas"; on: root.hover-open; toggled => { root.hover-open = !root.hover-open; root.settings-changed(); } }
                                ToggleRow { text: "Adzan"; on: root.adzan; toggled => { root.adzan = !root.adzan; root.settings-changed(); } }
                            }
                        }
                        Tile {
                            height: 56px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; spacing: 10px;
                                Text { text: "Warna aksen"; color: Theme.fg; font-size: 12.5px; vertical-alignment: center; }
                                HorizontalLayout {
                                    alignment: end; spacing: 8px;
                                    for c in [#5ae0ff, #9b8cff, #f08a5d, #34d399, #ff6b9a]: Rectangle {
                                        width: 24px;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2; width: 24px; height: 24px; border-radius: 12px; background: c;
                                            border-width: Theme.cyan == c ? 2px : 0px; border-color: Theme.fg;
                                            TouchArea { clicked => { Theme.cyan = c; root.settings-changed(); } }
                                        }
                                    }
                                }
                            }
                        }
                        Tile {
                            VerticalLayout {
                                padding-top: 4px; padding-bottom: 4px;
                                Rectangle { height: 22px; Text { x: 14px; text: "SUMBER SESI AI"; color: Theme.mut2; font-size: 10px; font-weight: 700; vertical-alignment: center; } }
                                ToggleRow { text: "Claude Code"; on: root.src-claude; toggled => { root.src-claude = !root.src-claude; root.settings-changed(); } }
                                ToggleRow { text: "GitHub Copilot CLI"; on: root.src-copilot; toggled => { root.src-copilot = !root.src-copilot; root.settings-changed(); } }
                                ToggleRow { text: "Antigravity"; on: root.src-agy; toggled => { root.src-agy = !root.src-agy; root.settings-changed(); } }
                                ToggleRow { text: "Claude Desktop"; on: root.src-desk; toggled => { root.src-desk = !root.src-desk; root.settings-changed(); } }
                            }
                        }
                        Tile {
                            height: 48px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px;
                                Text { text: "Kota sholat"; color: Theme.fg; font-size: 12.5px; vertical-alignment: center; }
                                Text { text: root.city + "  ▸"; color: Theme.cyan; font-size: 12.5px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.cycle-city(); } }
                        }
                        Text { text: "iCal, adzan .wav, lat/lon: edit settings.json"; color: Theme.mut2; font-size: 10.5px; wrap: word-wrap; }
                        Pill { text: "Keluar"; tint: #ff6b6b; clicked => { root.quit(); } }
                    }
                }
            }
        }
    }

    Path {
        x: root.width - 16px; y: island.y - 16px; width: 16px; height: 16px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 16; viewbox-height: 16;
        commands: "M 0 16 A 16 16 0 0 0 16 0 L 16 16 Z";
        fill: Theme.bg;
    }
    Path {
        x: root.width - 16px; y: island.y + island.height; width: 16px; height: 16px;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 16; viewbox-height: 16;
        commands: "M 0 0 A 16 16 0 0 1 16 16 L 16 0 Z";
        fill: Theme.bg;
    }
}
