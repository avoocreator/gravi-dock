import { Theme } from "theme.slint";
import { AppState, FaceParams, SessionItem, ApprovalItem, EventItem, AlarmItem, LapItem, CommitRow, RepoRow, ClipItem, ShelfItem, DayCell, PrayerRow, SearchHit } from "state.slint";
import { Icon, Icons, Label, Muted, Btn, IconBtn, Badge, Ornaments, Sparkle, Wave } from "widgets.slint";
import { Mascot } from "mascot.slint";
import { HomePage, AiPage, MusicPage, ClockPage } from "pages_a.slint";
import { CalendarPage, GithubPage, SystemPage, ClipPage, SettingsPage } from "pages_b.slint";

export { AppState, Theme, FaceParams, SessionItem, ApprovalItem, EventItem, AlarmItem, LapItem, CommitRow, RepoRow, ClipItem, ShelfItem, DayCell, PrayerRow, SearchHit }

component NavItem inherits Rectangle {
    in property <string> d;
    in property <int> index;
    in property <int> badge: 0;
    width: 44px;
    height: 44px;
    border-radius: 16px;
    background: AppState.page == root.index ? Theme.grad-v : (ta.has-hover ? Theme.surface2 : transparent);
    border-width: AppState.page == root.index ? 1px : 0px;
    border-color: #ffffff44;
    animate background { duration: 140ms; }
    Icon {
        d: root.d;
        size: 22px;
        tint: AppState.page == root.index ? Theme.on-accent : Theme.muted;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if AppState.page == root.index : Rectangle {
        x: (parent.width - 6px) / 2;
        y: parent.height - 9px;
        width: 5px;
        height: 5px;
        border-radius: 3px;
        background: Theme.on-accent;
    }
    if root.badge > 0 : Rectangle {
        x: parent.width - 15px;
        y: 0px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.bad;
        Text { text: root.badge; color: #ffffff; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { AppState.page = root.index; AppState.page-changed(root.index); } }
}

// kepala halaman: maskot + orbit, sapaan, tombol bulat (pengaturan di Beranda, tutup di halaman lain)
component PageHeader inherits Rectangle {
    height: 72px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 84px;
            if AppState.mascot-on : Path {
                x: 0px; y: 34px; width: 84px; height: 34px; viewbox-width: 84; viewbox-height: 34;
                commands: "M 4 14 C 4 2 70 2 80 12 C 84 20 40 32 6 22";
                stroke: Theme.accent.with-alpha(0.7);
                stroke-width: 2.5px;
                fill: transparent;
            }
            if AppState.mascot-on : Mascot { face: AppState.face; size: 78px; x: 3px; y: 0px; clicked => { AppState.mascot-clicked(); } }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: AppState.greeting; color: Theme.text; font-size: 22px; font-weight: 800; overflow: elide; }
            Text { text: AppState.date-long; color: Theme.accent; font-size: 13px; overflow: elide; }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 4px;
            IconBtn {
                d: AppState.page == 0 ? Icons.gear : Icons.close;
                size: 40px;
                clicked => { if (AppState.page == 0) { AppState.page = 8; AppState.page-changed(8); } else { AppState.collapse(); } }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Gravi Island";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                AppState.collapse();
                return accept;
            }
            return reject;
        }

        island := Rectangle {
            x: AppState.isl-x;
            y: AppState.isl-y;
            width: AppState.isl-w;
            height: AppState.isl-h;
            border-radius: AppState.mode == 0 ? (AppState.vertical ? 36px : self.height / 2) : 34px;
            background: AppState.mode == 0 ? (Theme.dark ? #050506 : #101114) : Theme.bg;
            border-width: 1px;
            border-color: AppState.mode == 0 ? Theme.accent.with-alpha(0.35) : Theme.edge;
            clip: true;
            animate x, y, width, height { duration: AppState.snap ? 0ms : 300ms; easing: ease-in-out; }
            animate border-radius, background { duration: AppState.snap ? 0ms : 300ms; }

            if AppState.mode != 0 : Ornaments { width: parent.width; height: parent.height; ghost: AppState.mode == 2; }

            // ================= PIL VERTIKAL =================
            if AppState.mode == 0 && AppState.vertical : Rectangle {
                width: parent.width;
                height: parent.height;
                TouchArea { clicked => { AppState.toggle-island(); } mouse-cursor: pointer; }
                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;
                    alignment: center;
                    if AppState.mascot-on : Mascot {
                        face: AppState.face;
                        size: 58px;
                        clicked => { AppState.toggle-island(); }
                    }
                    Text { text: AppState.clock; color: #f4f6fa; font-size: 15px; font-weight: 800; horizontal-alignment: center; }
                    if AppState.ai-running > 0 : Text { text: "AI ×" + AppState.ai-running; color: Theme.accent; font-size: 10px; font-weight: 800; horizontal-alignment: center; }
                    if AppState.ai-running == 0 && AppState.pill-line != "" : Text { text: AppState.pill-line; color: #8d95a5; font-size: 9px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                    HorizontalLayout { alignment: center; Icon { d: Icons.chev-down; size: 14px; tint: #8d95a5; } }
                }
                if AppState.badge > 0 : Rectangle {
                    x: parent.width - 24px;
                    y: 6px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.bad;
                    Text { text: AppState.badge; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            // ================= PIL HORIZONTAL (dock atas) =================
            if AppState.mode == 0 && !AppState.vertical : Rectangle {
                width: parent.width;
                height: parent.height;
                TouchArea { clicked => { AppState.toggle-island(); } mouse-cursor: pointer; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 14px;
                    spacing: 10px;
                    alignment: center;
                    if AppState.mascot-on : Mascot {
                        face: AppState.face;
                        size: 50px;
                        y: (parent.height - self.height) / 2;
                        clicked => { AppState.toggle-island(); }
                    }
                    if AppState.ai-running > 0 : VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.good; } }
                    Text { text: AppState.clock; color: #f4f6fa; font-size: 20px; font-weight: 800; vertical-alignment: center; }
                    Text { text: AppState.ai-running > 0 ? "AI ×" + AppState.ai-running : AppState.pill-line; color: #9aa1b4; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if AppState.ai-running > 1 : Rectangle {
                        width: 62px;
                        clip: true;
                        HorizontalLayout {
                            spacing: 0px;
                            for s in AppState.sessions : Rectangle {
                                width: s.running ? 30px : 0px;
                                Rectangle {
                                    x: 0px; y: (parent.height - 26px) / 2; width: 26px; height: 26px; border-radius: 13px;
                                    background: s.tint.with-alpha(0.3);
                                    border-width: 1px; border-color: s.tint;
                                    Text { text: s.mark; color: #ffffff; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if AppState.badge > 0 : VerticalLayout { alignment: center; Badge { text: AppState.badge + "!"; tint: Theme.bad; } }
                    VerticalLayout { alignment: center; Rectangle { width: 1px; height: 28px; background: #ffffff22; } }
                    VerticalLayout { alignment: center; Icon { d: Icons.chev-down; size: 20px; tint: #9aa1b4; } }
                }
            }

            // ================= PERINGATAN: PERSETUJUAN =================
            if AppState.mode == 1 : Rectangle {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        height: 58px;
                        if AppState.mascot-on : Mascot { face: AppState.face; size: 64px; interactive: false; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "Butuh persetujuan"; color: Theme.text; font-size: 20px; font-weight: 800; }
                            Text { text: AppState.approvals.length > 1 ? AppState.approvals.length + " permintaan menunggu" : "1 permintaan menunggu"; color: Theme.accent; font-size: 13px; }
                        }
                        VerticalLayout { alignment: center; IconBtn { d: Icons.close; size: 38px; clicked => { AppState.collapse(); } } }
                    }
                    if AppState.approvals.length > 0 : Rectangle {
                        vertical-stretch: 1;
                        border-radius: 22px;
                        background: @linear-gradient(155deg, Theme.surface 0%, Theme.surface2 100%);
                        border-width: 1px;
                        border-color: Theme.warn.with-alpha(0.55);
                        Rectangle { border-radius: 22px; background: @linear-gradient(160deg, Theme.warn.with-alpha(0.12) 0%, transparent 60%); }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 44px; height: 44px; border-radius: 22px;
                                        background: AppState.approvals[0].tint.with-alpha(0.28);
                                        Text { text: AppState.approvals[0].mark; color: AppState.approvals[0].tint; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: AppState.approvals[0].tool; color: Theme.text; font-size: 17px; font-weight: 800; overflow: elide; }
                                    Text { text: AppState.approvals[0].summary; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.edge; }
                            Muted { text: "Akses ke:"; }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout { alignment: center; Icon { d: Icons.folder; size: 18px; tint: Theme.muted; } }
                                Text { text: AppState.approvals[0].cwd; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { text: "Setujui"; kind: 1; clicked => { AppState.approve(AppState.approvals[0].id, 1); } }
                                Btn { text: "Tolak"; kind: 2; clicked => { AppState.approve(AppState.approvals[0].id, 0); } }
                                Rectangle { horizontal-stretch: 1; }
                                Btn { text: AppState.approvals.length > 1 ? "Semua" : "Terminal"; icon: Icons.terminal; clicked => { if (AppState.approvals.length > 1) { AppState.page = 1; AppState.toggle-island(); } else { AppState.approve(AppState.approvals[0].id, 2); } } }
                            }
                        }
                    }
                }
            }

            // ================= PANEL PENUH =================
            if AppState.mode == 2 : Rectangle {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 14px;
                    padding-bottom: 20px;
                    spacing: 10px;
                    PageHeader { }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        if AppState.page == 0 : HomePage { }
                        if AppState.page == 1 : AiPage { }
                        if AppState.page == 2 : MusicPage { }
                        if AppState.page == 3 : ClockPage { }
                        if AppState.page == 4 : CalendarPage { }
                        if AppState.page == 5 : GithubPage { }
                        if AppState.page == 6 : SystemPage { }
                        if AppState.page == 7 : ClipPage { }
                        if AppState.page == 8 : SettingsPage { }
                    }
                    Rectangle {
                        height: 60px;
                        border-radius: 30px;
                        background: @linear-gradient(90deg, Theme.surface 0%, Theme.surface2 100%);
                        border-width: 1px;
                        border-color: Theme.edge;
                        HorizontalLayout {
                            padding: 8px;
                            alignment: space-around;
                            NavItem { d: Icons.home; index: 0; }
                            NavItem { d: Icons.ai; index: 1; badge: AppState.badge; }
                            NavItem { d: Icons.music; index: 2; }
                            NavItem { d: Icons.clock; index: 3; }
                            NavItem { d: Icons.calendar; index: 4; }
                            NavItem { d: Icons.github; index: 5; }
                            NavItem { d: Icons.system; index: 6; }
                            NavItem { d: Icons.tray; index: 7; }
                            NavItem { d: Icons.settings; index: 8; }
                        }
                    }
                }
                if AppState.toast != "" : Rectangle {
                    y: parent.height - 136px;
                    x: (parent.width - self.width) / 2;
                    width: Math.min(parent.width - 28px, toast-text.preferred-width + 76px);
                    height: 52px;
                    border-radius: 18px;
                    background: @linear-gradient(90deg, Theme.surface2 0%, Theme.surface 100%);
                    border-width: 1px;
                    border-color: AppState.toast-kind == 2 ? Theme.bad : AppState.toast-kind == 1 ? Theme.accent : Theme.good;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px; height: 32px; border-radius: 16px;
                                background: (AppState.toast-kind == 2 ? Theme.bad : AppState.toast-kind == 1 ? Theme.accent : Theme.good).with-alpha(0.22);
                                Icon {
                                    d: AppState.toast-kind == 2 ? Icons.warn : AppState.toast-kind == 1 ? Icons.info : Icons.ok;
                                    size: 18px;
                                    tint: AppState.toast-kind == 2 ? Theme.bad : AppState.toast-kind == 1 ? Theme.accent : Theme.good;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        toast-text := Text { text: AppState.toast; color: Theme.text; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
    }
}
