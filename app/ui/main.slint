import { ScrollView } from "std-widgets.slint";
// Antigravity Island (Slint). Satu jendela transparan tetap di tepi kanan; yang beranimasi hanya ukuran "island" di dalamnya.

export struct MoodView {
    eye-h: float,
    eye-w: float,
    eye-dy: float,
    eye-dx: float,
    eye-shape: int,
    mouth: int,
    glyph: string,
    glyph-type: int,
    peek: bool,
    eye-color: color,
}

export struct SessionItem {
    title: string,
    sub: string,
    meta: string,
    mark: string,
    tint: color,
    running: bool,
    action: bool,
}

export global Theme {
    in-out property <bool> light: false;
    in-out property <color> cyan: #5ae0ff;
    out property <color> bg: light ? #f2f2f6 : #000000;
    out property <color> surface: light ? #ffffff : #141416;
    out property <color> border: light ? #0000000f : #ffffff12;
    out property <color> chip: light ? #0000000a : #ffffff12;
    out property <color> fg: light ? #16161a : #f5f5f7;
    out property <color> mut: light ? #16161a99 : #ffffff99;
    out property <color> mut2: light ? #16161a66 : #ffffff61;
    out property <color> card: light ? #ffffff : #141416;
    out property <color> line: light ? #0000001a : #ffffff24;
    out property <color> amber: #ffb54d;
    out property <color> good: #34d399;
}

// Maskot resmi Gravi Bot (vektor 3D mecha) dengan telinga pelangi & 12 ekspresi halus.
component Gravi inherits Rectangle {
    in property <length> size: 40px;
    in property <bool> blink: false;
    in property <MoodView> mood: {
        eye-h: 1.0, eye-w: 1.0, eye-dy: 0.0, eye-dx: 0.0,
        eye-shape: 0, mouth: 0, glyph: "", glyph-type: 0, peek: false,
        eye-color: #5ae0ff
    };
    width: self.size;
    height: self.size * 0.88;

    property <length> u: self.size / 100;
    property <length> eh: root.blink ? 2.5 * root.u : max(2.5 * root.u, root.mood.eye-h * 18.0 * root.u);
    property <length> ew: max(4.0 * root.u, root.mood.eye-w * 9.0 * root.u);
    property <length> m-y: 24 * root.u + root.mood.eye-dy * 5 * root.u - root.eh / 2;
    property <length> lx: 18 * root.u + root.mood.eye-dx * 6 * root.u;
    property <length> rx: 45 * root.u + root.mood.eye-dx * 6 * root.u;

    // Bayangan Bawah 3D (Ambient Occlusion Helm)
    Rectangle {
        x: 10 * root.u;
        y: 68 * root.u;
        width: 80 * root.u;
        height: 14 * root.u;
        border-radius: 7 * root.u;
        background: #00000030;
    }

    // Telinga Kiri Luar (Mecha Carbon / 3D Bevel)
    Path {
        x: 4 * root.u; y: 0; width: 34 * root.u; height: 36 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 34; viewbox-height: 36;
        commands: "M 4 36 L 14 3 Q 18 0 22 5 L 34 36 Z";
        fill: @linear-gradient(135deg, #232738 0%, #12141c 100%);
    }
    // Telinga Kiri Dalam (Gradien Pelangi Dingin: Biru -> Cyan -> Emerald)
    Path {
        x: 8 * root.u; y: 5 * root.u; width: 24 * root.u; height: 28 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 28;
        commands: "M 3 28 L 10 5 Q 13 2 16 6 L 23 28 Z";
        fill: @linear-gradient(145deg, #1d4ed8 0%, #06b6d4 50%, #10b981 100%);
    }

    // Telinga Kanan Luar (Mecha Carbon / 3D Bevel)
    Path {
        x: 62 * root.u; y: 0; width: 34 * root.u; height: 36 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 34; viewbox-height: 36;
        commands: "M 0 36 L 12 5 Q 16 0 20 3 L 30 36 Z";
        fill: @linear-gradient(225deg, #232738 0%, #12141c 100%);
    }
    // Telinga Kanan Dalam (Gradien Pelangi Hangat: Crimson -> Oranye -> Kuning)
    Path {
        x: 68 * root.u; y: 5 * root.u; width: 24 * root.u; height: 28 * root.u;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 28;
        commands: "M 1 28 L 8 6 Q 11 2 14 5 L 21 28 Z";
        fill: @linear-gradient(215deg, #dc2626 0%, #ea580c 50%, #facc15 100%);
    }

    // Bodi Helm Utama (Volumetrik Keramik Putih 3D dengan Shading & Highlight Halus)
    Rectangle {
        x: 5 * root.u;
        y: root.mood.peek ? 24 * root.u : 14 * root.u;
        width: 90 * root.u;
        height: 68 * root.u;
        border-radius: 34 * root.u;
        background: @linear-gradient(180deg, #ffffff 0%, #edf1fa 60%, #cbd4ea 100%);
        border-width: 1.5px;
        border-color: #dbe0ee;
        clip: true;

        // Highlight pantulan kubah atas helm
        Rectangle {
            x: 18 * root.u; y: 2 * root.u; width: 54 * root.u; height: 8 * root.u;
            border-radius: 4 * root.u;
            background: @linear-gradient(180deg, #ffffffbb 0%, #ffffff00 100%);
        }

        // Bayangan bezel dalam di sekitar lubang visor
        Rectangle {
            x: 8 * root.u; y: 9 * root.u; width: 74 * root.u; height: 50 * root.u;
            border-radius: 25 * root.u;
            background: #11131a22;
        }

        // Visor Kaca Hitam Mengkilap (3D Convex Glass Lens)
        Rectangle {
            x: 9 * root.u; y: 10 * root.u; width: 72 * root.u; height: 48 * root.u;
            border-radius: 24 * root.u;
            background: @linear-gradient(180deg, #181b28 0%, #0a0c12 100%);
            border-width: 1.2px;
            border-color: #2b3145;
            clip: true;

            // Pantulan kaca melengkung (Specular Curved Glass Pill)
            Rectangle {
                x: 6 * root.u; y: 4 * root.u; width: 24 * root.u; height: 9 * root.u;
                border-radius: 4.5 * root.u;
                background: @linear-gradient(135deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0.05) 100%);
            }
            // Pantulan sekunder kaca bawah (Rim bounce glow)
            Rectangle {
                x: 18 * root.u; y: 40 * root.u; width: 36 * root.u; height: 5 * root.u;
                border-radius: 2.5 * root.u;
                background: @linear-gradient(180deg, rgba(90, 224, 255, 0.0) 0%, rgba(90, 224, 255, 0.16) 100%);
            }

            // === SEPASANG MATA VISOR DENGAN 12 EKSPRESI BERSIH ===
            // 0. Bentuk Kapsul Tegak (Idle, Working, Searching, Peek)
            if root.mood.eye-shape == 0: Rectangle {
                x: root.lx; y: root.m-y; width: root.ew; height: root.eh;
                border-radius: root.ew / 2; background: root.mood.eye-color;
                animate height { duration: 100ms; }
            }
            if root.mood.eye-shape == 0: Rectangle {
                x: root.rx; y: root.m-y; width: root.ew; height: root.eh;
                border-radius: root.ew / 2; background: root.mood.eye-color;
                animate height { duration: 100ms; }
            }

            // 1. Bentuk Senyum ^^ (Happy, Success, Love, Music)
            if root.mood.eye-shape == 1: Path {
                x: root.lx - 2 * root.u; y: root.m-y; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 11 Q 7 1 13 11";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }
            if root.mood.eye-shape == 1: Path {
                x: root.rx - 2 * root.u; y: root.m-y; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 11 Q 7 1 13 11";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }

            // 2. Bentuk Bulat Besar OO (Surprised / Alert)
            if root.mood.eye-shape == 2: Rectangle {
                x: root.lx - 2 * root.u; y: root.m-y - 1 * root.u;
                width: 14 * root.u; height: 14 * root.u; border-radius: 7 * root.u;
                background: root.mood.eye-color;
            }
            if root.mood.eye-shape == 2: Rectangle {
                x: root.rx - 2 * root.u; y: root.m-y - 1 * root.u;
                width: 14 * root.u; height: 14 * root.u; border-radius: 7 * root.u;
                background: root.mood.eye-color;
            }

            // 3. Bentuk Tidur/Tenang -- (Sleepy, Sleeping, Zen)
            if root.mood.eye-shape == 3: Rectangle {
                x: root.lx - 1 * root.u; y: 24 * root.u;
                width: 12 * root.u; height: 3.2 * root.u; border-radius: 1.6 * root.u;
                background: root.mood.eye-color;
            }
            if root.mood.eye-shape == 3: Rectangle {
                x: root.rx - 1 * root.u; y: 24 * root.u;
                width: 12 * root.u; height: 3.2 * root.u; border-radius: 1.6 * root.u;
                background: root.mood.eye-color;
            }

            // 4. Bentuk Bingung / Curious (Asimetris: kiri kapsul, kanan strip)
            if root.mood.eye-shape == 4: Rectangle {
                x: root.lx; y: root.m-y; width: root.ew; height: root.eh;
                border-radius: root.ew / 2; background: root.mood.eye-color;
            }
            if root.mood.eye-shape == 4: Rectangle {
                x: root.rx; y: 24 * root.u; width: 12 * root.u; height: 3.2 * root.u;
                border-radius: 1.6 * root.u; background: root.mood.eye-color;
            }

            // 5. Bentuk Sayu/Sedih (Sad)
            if root.mood.eye-shape == 5: Path {
                x: root.lx - 1 * root.u; y: root.m-y + 2 * root.u; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 2 Q 7 11 13 2";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }
            if root.mood.eye-shape == 5: Path {
                x: root.rx - 1 * root.u; y: root.m-y + 2 * root.u; width: 14 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 14; viewbox-height: 12;
                commands: "M 1 2 Q 7 11 13 2";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }

            // 6. Bentuk Menyipit Tajam (Thinking / Focused)
            if root.mood.eye-shape == 6: Path {
                x: root.lx; y: root.m-y; width: 12 * root.u; height: 10 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 10;
                commands: "M 1 2 L 11 9";
                stroke: root.mood.eye-color; stroke-width: 3.5px; fill: transparent;
            }
            if root.mood.eye-shape == 6: Path {
                x: root.rx; y: root.m-y; width: 12 * root.u; height: 10 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 10;
                commands: "M 1 9 L 11 2";
                stroke: root.mood.eye-color; stroke-width: 3.5px; fill: transparent;
            }

            // 7. Bentuk Silang XX (Error / Dizzy)
            if root.mood.eye-shape == 7: Path {
                x: root.lx; y: root.m-y; width: 12 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 12;
                commands: "M 2 2 L 10 10 M 10 2 L 2 10";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }
            if root.mood.eye-shape == 7: Path {
                x: root.rx; y: root.m-y; width: 12 * root.u; height: 12 * root.u;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 12;
                commands: "M 2 2 L 10 10 M 10 2 L 2 10";
                stroke: root.mood.eye-color; stroke-width: 3.2px; fill: transparent;
            }
        }
    }
}

// === KOMPONEN IKON VEKTOR MURNI (BEBAS TOFU / KOTAK-KOTAK WINDOWS) ===
