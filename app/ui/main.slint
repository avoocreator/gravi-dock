component AvooAvatar inherits Rectangle {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: #181a24;
    border-width: 1px;
    border-color: #ffffff14;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 14;
        commands: "M 3 12 L 8 3 L 13 12";
        stroke: @linear-gradient(180deg, #f59e0b 0%, #ea580c 100%);
        stroke-width: 3.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

