export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.text;
    in property <bool> solid: false;
    in property <length> size: 20px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    stroke: root.solid ? transparent : root.tint;
    fill: root.solid ? root.tint : transparent;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// ---------- kartu ----------
export component Card inherits Rectangle {
    in property <brush> fill: Theme.card-fill;
    in property <color> tint: Theme.accent;
    in property <color> line: Theme.dark ? #ffffff1c : Theme.border;
    background: root.fill;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.line;
    Rectangle {
        border-radius: Theme.radius-card;
        background: @linear-gradient(145deg, root.tint.with-alpha(0.18) 0%, transparent 62%);
    }
    @children
}

// bintang empat sudut (ornamen)
export component Sparkle inherits Path {
    in property <color> tint: Theme.accent2;
    in property <length> size: 14px;
    width: root.size;
    height: root.size;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: "M 8 0 Q 8 8 16 8 Q 8 8 8 16 Q 8 8 0 8 Q 8 8 8 0 Z";
    fill: root.tint;
}

// latar ornamen: gelembung gradien + bintang + siluet maskot raksasa; semua mengikuti skema warna
export component Ornaments inherits Rectangle {
    in property <bool> ghost: true;
    clip: true;
    Path {
        width: parent.width; height: parent.height; viewbox-width: 440; viewbox-height: 660;
        commands: "M 440 0 L 440 190 C 380 170 300 110 330 0 Z";
        fill: @linear-gradient(200deg, Theme.glow 0%, transparent 100%);
    }
    Path {
        width: parent.width; height: parent.height; viewbox-width: 440; viewbox-height: 660;
        commands: "M 0 660 L 0 540 C 90 520 190 590 250 660 Z";
        fill: @linear-gradient(20deg, Theme.glow 0%, transparent 100%);
    }
    Path {
        width: parent.width; height: parent.height; viewbox-width: 440; viewbox-height: 660;
        commands: "M 440 660 L 440 500 C 380 520 330 580 320 660 Z";
        fill: @linear-gradient(340deg, Theme.glow2 0%, transparent 100%);
    }
    if root.ghost : Path {
        x: parent.width - 215px; y: 14px; width: 210px; height: 158px; viewbox-width: 200; viewbox-height: 150;
        commands: "M 6 108 C 6 52 48 22 100 22 C 152 22 194 52 194 108 C 194 133 168 148 100 148 C 32 148 6 133 6 108 Z M 40 40 L 36 0 L 78 26 Z";
        fill: Theme.accent.with-alpha(Theme.dark ? 0.10 : 0.08);
    }
    if root.ghost : Rectangle { x: parent.width - 160px; y: 84px; width: 15px; height: 34px; border-radius: 8px; background: Theme.accent.with-alpha(0.14); }
    if root.ghost : Rectangle { x: parent.width - 108px; y: 84px; width: 15px; height: 34px; border-radius: 8px; background: Theme.accent.with-alpha(0.14); }
    Sparkle { x: parent.width * 0.62; y: 26px; size: 22px; tint: Theme.accent.with-alpha(0.65); }
    Sparkle { x: 14px; y: 92px; size: 9px; tint: Theme.accent2.with-alpha(0.6); }
    Sparkle { x: parent.width - 60px; y: parent.height - 190px; size: 12px; tint: Theme.accent.with-alpha(0.55); }
    Sparkle { x: parent.width * 0.18; y: parent.height - 160px; size: 8px; tint: Theme.accent2.with-alpha(0.5); }
}

// gelombang suara kecil (agen sedang bekerja)
export component Wave inherits Rectangle {
    in property <color> tint: Theme.accent;
    property <int> ph: 0;
    width: 44px;
    height: 26px;
    Timer { interval: 200ms; running: true; triggered => { root.ph = Math.mod(root.ph + 1, 8); } }
    for i in 7 : Rectangle {
        x: i * 6.5px;
        width: 3px;
        height: (5 + Math.mod(i * 3 + root.ph * 2, 7) * 3) * 1px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.tint;
        animate height { duration: 200ms; easing: ease-in-out; }
    }
}

export component Label inherits Text {
    in property <bool> strong: false;
    color: Theme.text;
    font-size: 13px;
    font-weight: root.strong ? 700 : 500;
    overflow: elide;
}

export component Muted inherits Text {
    color: Theme.muted;
    font-size: 11px;
    font-weight: 500;
    overflow: elide;
}

export component SectionTitle inherits Text {
    color: Theme.accent;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// ---------- tombol ----------
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;        // 0 netral, 1 aksen (gradien), 2 bahaya
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    preferred-width: row.preferred-width + 6px;
    border-radius: 19px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.kind == 1 ? Theme.grad : root.kind == 2 ? Theme.bad.with-alpha(0.18) : Theme.surface3;
    border-width: root.kind == 1 ? 0px : 1px;
    border-color: root.kind == 2 ? Theme.bad.with-alpha(0.55) : Theme.border;
    states [
        pressed when ta.pressed && root.enabled: { opacity: 0.75; }
    ]
    animate opacity { duration: 100ms; }
    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        padding-left: 16px;
        padding-right: 16px;
        if root.icon != "" : VerticalLayout { alignment: center; Icon { d: root.icon; size: 16px; tint: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.bad : Theme.text; } }
        Text {
            text: root.text;
            color: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.bad : Theme.text;
            font-size: 13px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconBtn inherits Rectangle {
    in property <string> d;
    in property <length> size: 36px;
    in property <bool> solid: false;
    in property <bool> filled: true;      // lingkaran berlatar
    in property <color> tint: Theme.text;
    in property <color> fill: Theme.surface3.with-alpha(0.85);
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.filled ? (ta.pressed ? Theme.border : root.fill) : transparent;
    border-width: root.filled ? 1px : 0px;
    border-color: #ffffff20;
    animate background { duration: 120ms; }
    Icon {
        d: root.d;
        solid: root.solid;
        tint: root.tint;
        size: root.size * 0.48;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---------- kontrol ----------
export component Toggle inherits Rectangle {
    in-out property <bool> on: false;
    callback toggled(bool);
    width: 52px;
    height: 30px;
    border-radius: 15px;
    background: root.on ? Theme.grad : @linear-gradient(90deg, Theme.surface3 0%, Theme.surface3 100%);
    border-width: 1px;
    border-color: root.on ? transparent : Theme.border;
    Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        y: 3px;
        x: root.on ? 25px : 3px;
        background: #ffffff;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// kontrol segmen: kapsul kaca, segmen aktif berisi gradien; ikon opsional
export component Seg inherits Rectangle {
    in property <[string]> items;
    in property <[string]> icons;
    in-out property <int> current: 0;
    callback picked(int);
    height: 46px;
    background: @linear-gradient(90deg, Theme.surface 0%, Theme.surface2 100%);
    border-radius: 23px;
    border-width: 1px;
    border-color: Theme.edge;
    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for it[i] in root.items : Rectangle {
            border-radius: 19px;
            background: i == root.current ? Theme.grad : transparent;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                if root.icons.length > i : VerticalLayout { alignment: center; Icon { d: root.icons[i]; size: 16px; tint: i == root.current ? Theme.on-accent : Theme.muted; } }
                Text {
                    text: it;
                    color: i == root.current ? Theme.on-accent : Theme.muted;
                    font-size: 12px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            TouchArea {
                clicked => {
                    root.current = i;
                    root.picked(i);
                }
            }
        }
    }
}

// - 25 + (bulat)
export component Stepper inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> step: 1;
    in property <string> suffix: "";
    callback changed(int);
    height: 38px;
    preferred-width: 150px;
    background: Theme.surface2;
    border-radius: 19px;
    HorizontalLayout {
        padding: 3px;
        Rectangle {
            width: 32px;
            border-radius: 16px;
            background: Theme.surface3;
            Icon { d: Icons.minus; size: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            TouchArea { clicked => { root.value = Math.max(root.min, root.value - root.step); root.changed(root.value); } }
        }
        Text {
            text: root.value + root.suffix;
            color: Theme.text;
            font-size: 15px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 32px;
            border-radius: 16px;
            background: Theme.surface3;
            Icon { d: Icons.plus; size: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            TouchArea { clicked => { root.value = Math.min(root.max, root.value + root.step); root.changed(root.value); } }
        }
    }
}

export component SliderLite inherits Rectangle {
    in-out property <float> value: 0.5;      // 0..1
    callback changed(float);
    height: 26px;
    Rectangle {
        y: (parent.height - 8px) / 2;
        height: 8px;
        border-radius: 4px;
        background: Theme.surface3;
    }
    Rectangle {
        y: (parent.height - 8px) / 2;
        width: root.value * parent.width;
        height: 8px;
        border-radius: 4px;
        background: Theme.grad;
    }
    Rectangle {
        x: root.value * (parent.width - 20px);
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        border-width: 2px;
        border-color: Theme.accent;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down && self.width > 0px) {
                root.value = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed && self.width > 0px) {
                root.value = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.value);
            }
        }
    }
}

export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> secret: false;
    callback accepted(string);
    callback edited(string);
    height: 40px;
    background: Theme.surface2;
    border-radius: 20px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.edge;
    Text {
        x: 14px;
        y: 0;
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        visible: root.text == "";
    }
    ti := TextInput {
        x: 14px;
        y: 0;
        width: parent.width - 28px;
        height: parent.height;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

// ---------- visual data ----------
export component Ring inherits Rectangle {
    in property <float> value: 0.0;           // 0..1
    in property <length> size: 64px;
    in property <color> tint: Theme.accent;
    in property <string> text;
    in property <string> sub;
    in property <string> icon;
    property <float> v: Math.clamp(root.value, 0.001, 0.999);
    property <angle> a: 360deg * root.v;
    width: root.size;
    height: root.size;
    Rectangle {
        border-radius: root.size / 2;
        border-width: 6px;
        border-color: Theme.surface3.with-alpha(0.7);
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 6 A 44 44 0 \{root.v > 0.5 ? 1 : 0} 1 \{50 + 44 * Math.sin(root.a)} \{50 - 44 * Math.cos(root.a)}";
        stroke: root.tint;
        stroke-width: 6.5px;
        stroke-line-cap: round;
        fill: transparent;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        if root.icon != "" : HorizontalLayout { alignment: center; Icon { d: root.icon; size: root.size * 0.22; tint: root.tint; } }
        Text { text: root.text; color: Theme.text; font-size: root.size * 0.22; font-weight: 800; horizontal-alignment: center; }
        if root.sub != "" : Text { text: root.sub; color: Theme.muted; font-size: root.size * 0.13; font-weight: 700; horizontal-alignment: center; }
    }
}

export component Spark inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <color> tint: Theme.accent;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 120;
        viewbox-height: 40;
        commands: root.area;
        fill: @linear-gradient(180deg, root.tint.with-alpha(0.35) 0%, root.tint.with-alpha(0.0) 100%);
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 120;
        viewbox-height: 40;
        commands: root.line;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-join: round;
        stroke-line-cap: round;
        fill: transparent;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    height: 20px;
    preferred-width: t.preferred-width + 14px;
    border-radius: 10px;
    background: root.tint.with-alpha(0.2);
    t := Text { text: root.text; color: root.tint; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
}

// judul bagian dengan garis tipis (seperti di referensi)
export component Heading inherits HorizontalLayout {
    in property <string> text;
    in property <string> icon;
    spacing: 10px;
    height: 24px;
    if root.icon != "" : VerticalLayout { alignment: center; Icon { d: root.icon; size: 18px; tint: Theme.accent; } }
    Text { text: root.text; color: Theme.text; font-size: 15px; font-weight: 800; vertical-alignment: center; }
    VerticalLayout { alignment: center; horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.edge; } }
}

