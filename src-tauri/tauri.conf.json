{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravi",
  "version": "0.1.0",
  "identifier": "app.gravi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:hook && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gravi",
        "width": 540,
        "height": 760,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "avoocreator",
    "copyright": "Copyright (c) 2026 avoocreator",
    "shortDescription": "Floating Dynamic Island dock for Windows",
    "longDescription": "Compact interactive Dynamic Island dock for Windows with media controls, AI session tracking, LocalDrop file sharing, clipboard history, and system status.",
    "licenseFile": "../LICENSE",
    "resources": [
      "resources/*"
    ],
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
